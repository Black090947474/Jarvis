<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:fontFamily="sans-serif-light" />

        <TextClock
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d. MMMM"
            android:format24Hour="EEEE, d. MMMM"
            android:textColor="#C8C8D4"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FF5A66"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#8C8C98"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/w_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_mic_bg"
            android:padding="14dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Mit Jarvis sprechen" />

        <TextView
            android:id="@+id/w_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="4dp"
            android:text="Chat"
            android:textColor="#C8C8D4"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
